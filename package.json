{
  "name": "mabril-desktop",
  "productName": "Burbuja",
  "version": "0.2.0",
  "private": true,
  "main": "main.js",
  "license": "UNLICENSED",
  "description": "Burbuja — la app de escritorio de la red MABRIL.",
  "author": {
    "name": "MABRIONA",
    "email": "mywber@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dir",
    "dist:win": "electron-builder --win nsis --publish=never",
    "dist": "electron-builder --mac --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mabril.app",
    "productName": "Burbuja",
    "copyright": "Copyright © 2026 MABRIONA Corporation",
    "icon": "build/icon.icns",
    "files": [
      "main.js",
      "mabriona-update/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Burbuja",
      "icon": "build/icon.icns",
      "background": "build/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 80,
      "contents": [
        {
          "x": 140,
          "y": 210,
          "type": "file"
        },
        {
          "x": 400,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "build/icons",
      "category": "Network",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "legalTrademarks": "MABRIONA Corporation",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/installerHeaderIcon.ico",
      "uninstallerIcon": "build/installerHeaderIcon.ico",
      "installerHeaderIcon": "build/installerHeaderIcon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "nucleo733",
      "repo": "BURBUJA-DESKTOP"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
