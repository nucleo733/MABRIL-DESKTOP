{
  "name": "mabril-desktop",
  "productName": "Burbuja",
  "version": "0.2.0",
  "private": true,
  "main": "main.js",
  "license": "UNLICENSED",
  "description": "Burbuja — la app de escritorio de la red MABRIL.",
  "author": {
    "name": "MABRIONA",
    "email": "mywber@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dir",
    "dist": "electron-builder --mac --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mabril.app",
    "productName": "Burbuja",
    "icon": "build/icon.icns",
    "files": ["main.js"],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.social-networking",
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }]
    },
    "linux": {
      "icon": "build/icons",
      "category": "Network",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}
